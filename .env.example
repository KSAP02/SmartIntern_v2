# Copy to .env. Never put a comment on the same line as a value.
# Secrets + infrastructure only. Models, temperature, limits etc. live in settings/config.toml.

# OpenAI key, used for the chat model and (unless EMBEDDING_API_KEY is set) embeddings
LLM_API_KEY=
# Optional: any OpenAI-compatible endpoint
LLM_BASE_URL=
# Optional overrides of settings/config.toml [llm] provider / model (blank = use the file)
LLM_PROVIDER=
LLM_MODEL=

# Optional: separate key / endpoint for embeddings (blank = reuse LLM_*)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# JSearch job search API key. From OpenWeb Ninja (app.openwebninja.com, the default) or from
# RapidAPI; say which in Admin settings -> JSearch -> provider. Blank = no jobs are fetched.
# After changing it: docker compose up -d --force-recreate backend (restart / up -d alone keep the old value).
JSEARCH_API_KEY=

# Where app data lives on local (non-Docker) runs. Compose sets /app/data.
DATA_DIR=
# local (S3-compatible storage arrives at deploy)
STORAGE_BACKEND=local
# Vector store location. Blank = Milvus Lite file in DATA_DIR.
# (Not named MILVUS_URI: pymilvus reads that name itself and rejects file paths.)
VECTOR_DB_URI=
# Folder that gets a read-only copy of app.db after every change (for notebooks).
# Blank = off. Compose sets /app/snapshots = data_warehouse/snapshots on your machine.
SNAPSHOT_DIR=

# Host ports (docker compose and local runs)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Where the frontend server finds the backend on local runs. Compose overrides it.
BACKEND_URL=http://localhost:8000

# ---- Deployed split (frontend on Vercel, backend on Render). Leave blank locally. ----
# Backend: comma-separated frontend origins allowed by CORS, e.g. https://smartintern.vercel.app
CORS_ORIGINS=
# Frontend (set in Vercel's env vars, read at build time): the backend's public URL,
# e.g. https://smartintern-api.onrender.com. Blank = same-origin /api (local / Docker).
VITE_API_BASE_URL=
